VK_TOKEN=vk1.a.your_community_token
PROXYAPI_KEY=sk-your_proxyapi_key

# Логин/пароль (SSO account.garant.ru). Режим browser.
GARANT_LOGIN=your_login@example.com
GARANT_PASSWORD=your_password
GARANT_TOKEN=your_garant_api_token
GARANT_MODE=api
# browser / api / mcp

# Целевой сайт ленты ПРАЙМ (режим browser). По умолчанию internet.garant.ru.
# Для временной демо-лицензии: https://demo.garant.ru
GARANT_BROWSER_BASE_URL=https://internet.garant.ru
